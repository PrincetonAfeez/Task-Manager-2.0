# Copy to .env and fill in. .env is gitignored and never committed.
# Values shown are development defaults; production requires the marked ones.

# --- Environment profile -------------------------------------------------------
# development | test | production
DJANGO_ENV=development
DJANGO_DEBUG=1

# --- Secrets (REQUIRED in production) ------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Comma-separated previous keys, so a rotation does not invalidate live sessions.
DJANGO_SECRET_KEY_FALLBACKS=

# --- Hosts (REQUIRED in production) --------------------------------------------
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://tasks.example.com
SITE_URL=http://127.0.0.1:8000

# --- Database (server DB REQUIRED in production) -------------------------------
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=60
DB_REQUIRE_SSL=1

# --- Cache and broker (REQUIRED in production) ---------------------------------
REDIS_URL=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CACHE_KEY_PREFIX=taskmgr

# --- Transport security --------------------------------------------------------
BEHIND_TLS_PROXY=0
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_HSTS_SECONDS=0

# --- Admin ---------------------------------------------------------------------
# Move the admin off the guessable default in production.
DJANGO_ADMIN_URL=admin/

# --- Email ---------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Task Manager <no-reply@example.com>

# --- Rate limits ---------------------------------------------------------------
THROTTLE_ANON=30/minute
THROTTLE_USER=1000/hour
THROTTLE_BURST=60/minute
THROTTLE_AUTH=10/minute
THROTTLE_WRITE=300/hour
THROTTLE_EXPORT=10/hour
LOGIN_LOCKOUT_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_WINDOW_SECONDS=900

# --- Queue tuning --------------------------------------------------------------
QUEUE_DISPATCH_BATCH_SIZE=100
# Seconds one dispatcher tick keeps claiming jobs. Keep below the 10s beat interval.
QUEUE_DISPATCH_TIME_BUDGET_SECONDS=8
QUEUE_DEFAULT_LEASE_SECONDS=300
QUEUE_RETRY_BASE_SECONDS=10
QUEUE_RETRY_MAX_SECONDS=3600
QUEUE_BACKLOG_ALERT_THRESHOLD=500

# --- Webhooks ------------------------------------------------------------------
WEBHOOK_CONNECT_TIMEOUT=5
WEBHOOK_READ_TIMEOUT=10
# Blocks SSRF into internal networks. Keep 0 in production.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=1

# --- Observability -------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=console
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
APP_RELEASE=dev

# --- Web capacity --------------------------------------------------------------
# gunicorn worker processes. The app is CPU-bound, so roughly one per available core.
WEB_CONCURRENCY=3

# --- Identity (two-step verification, single sign-on) --------------------------
# Encrypts stored TOTP seeds and SSO client secrets. Generate with
#   python manage.py generate_field_key
# Comma separated, newest first; every key decrypts, the first encrypts. REQUIRED in
# production in practice: without it the key is derived from DJANGO_SECRET_KEY, and
# rotating that would make every enrolled authenticator unreadable.
FIELD_ENCRYPTION_KEYS=
MFA_ISSUER=Task Manager
MFA_MAX_FAILURES=5
MFA_LOCKOUT_SECONDS=900
STAFF_REQUIRE_MFA=0
# Allow http:// identity providers. Local development against a test IdP only; ignored
# when DJANGO_ENV=production.
SSO_ALLOW_INSECURE_PROVIDERS=0

# --- Payments (Stripe) ---------------------------------------------------------
# Leave STRIPE_SECRET_KEY empty to run without a payment processor. See docs/BILLING.md.
STRIPE_SECRET_KEY=
# Required whenever STRIPE_SECRET_KEY is set; the app refuses to start without it.
STRIPE_WEBHOOK_SECRET=
# Which Stripe price sells which plan: team=price_...,business=price_...
STRIPE_PRICE_IDS=
# Permit an sk_test_ key with DJANGO_ENV=production (staging only).
STRIPE_ALLOW_TEST_KEY=0
# With no processor, may a workspace put itself on a paid plan for free?
# Defaults to 1 in development and 0 in production.
BILLING_ALLOW_UNPAID_PLAN_CHANGES=1

# --- Attachment malware scanning -----------------------------------------------
# Empty disables scanning. "clamav" sends every upload to clamd and blocks downloads
# until it is declared clean (docker compose --profile scanning up -d).
ATTACHMENT_SCAN_BACKEND=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# --- Media storage -------------------------------------------------------------
# filesystem (default) | s3 — see docs/STORAGE.md
MEDIA_BACKEND=filesystem
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=
# AWS_QUERYSTRING_AUTH=1

# --- Queue fairness / optional RLS ---------------------------------------------
QUEUE_FAIRNESS_ENABLED=1
QUEUE_FAIRNESS_WINDOW_SECONDS=60
# Defence in depth; requires `python manage.py enable_rls` on Postgres. See docs/RLS.md.
ENABLE_POSTGRES_RLS=0
